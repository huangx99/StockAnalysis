# CORS origins (comma-separated)
STOCK_CORS_ORIGINS=["http://localhost:3000"]

# AI Provider: "claude" | "openai" | "custom"
STOCK_AI_PROVIDER=claude

# Claude
STOCK_ANTHROPIC_API_KEY=sk-ant-...
STOCK_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
STOCK_OPENAI_API_KEY=sk-...
STOCK_OPENAI_MODEL=gpt-4o

# Custom (OpenAI-compatible)
STOCK_CUSTOM_API_KEY=
STOCK_CUSTOM_BASE_URL=http://localhost:11434/v1
STOCK_CUSTOM_MODEL=llama3

# Cache TTLs (seconds)
STOCK_CACHE_TTL_SPOT=30
STOCK_CACHE_TTL_KLINE=300
STOCK_CACHE_TTL_FINANCIALS=86400
STOCK_CACHE_TTL_NEWS=600
STOCK_CACHE_TTL_SEARCH=3600
